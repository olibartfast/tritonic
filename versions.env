# Centralized version pins for tritonic. Single source of truth.
# cmake/versions.cmake reads this for CMake (CMakeLists.txt, backends/yolopreprocess/CMakeLists.txt).
# scripts/versions.sh reads this for shell scripts; source versions.sh, never versions.env directly.
# Formats that cannot read a file (Dockerfile ARG defaults, Helm chart, k8s manifests,
# the Colab notebook, CI cache-key strings) restate these values as literals;
# scripts/check_version_sync.sh (run by .github/workflows/ci.yml) fails on drift.
# Every variable is overridable from the environment or via `cmake -D`; the loaders
# never clobber an already-set value.

# neuriplo-tasks sibling dependency (FetchContent)
NEURIPLO_TASKS_VERSION=v0.8.0

# GoogleTest (FetchContent)
GTEST_VERSION=v1.14.0

# NGC monthly container tag: nvcr.io/nvidia/tritonserver and nvcr.io/nvidia/tensorrt images
NGC_CONTAINER_TAG=26.08

# triton-inference-server/{common,core,backend} tag for the yolopreprocess backend
TRITON_REPO_TAG=r26.08

# TensorRT inside NGC_CONTAINER_TAG (prefixed to avoid collision with NGC image env)
NGC_TENSORRT_VERSION=11.2.1.2

# NVIDIA DALI; must match the DALI build inside NGC_CONTAINER_TAG (prefixed to avoid collision with NGC image env)
NGC_DALI_VERSION=2.2.0

# CUDA Toolkit series TensorRT is built against (prefixed to avoid collision with NGC image env)
NGC_CUDA_VERSION=13.3

# Default CMake CUDA architectures for tritonic_cuda and the yolopreprocess backend
CUDA_ARCHITECTURES=75;80;86;89
