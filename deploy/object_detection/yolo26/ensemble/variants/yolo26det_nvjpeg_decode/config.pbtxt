name: "yolo26det_nvjpeg_decode"
backend: "yolopreprocess"
max_batch_size: 1
input [{ name: "IMAGE" data_type: TYPE_UINT8 dims: [-1] }]
output [
  { name: "DECODED" data_type: TYPE_UINT8 dims: [-1, -1, 3] },
  { name: "ORIGINAL_SIZE" data_type: TYPE_INT64 dims: [2] }
]
instance_group [{ kind: KIND_GPU count: 1 }]
parameters [
  { key: "mode" value: { string_value: "decode" } },
  { key: "max_side" value: { string_value: "4096" } }
]
